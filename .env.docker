# Database Environment Variables for Docker
NCBI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Database URLs for Docker network
POSTGRES_URL=postgresql+psycopg2://nasa_user:nasa_password@postgres:5432/nasa_publications
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nasa_password
NEO4J_DATABASE=neo4j
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true